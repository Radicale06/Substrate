node_modules/
dist/
build/
frontend/.vite/

# Prisma generates its client into the source tree
backend/src/generated/
*.tsbuildinfo

# Local env and secrets
.env
.secret.*
*.local

# Saved screenshots (the runtime writes these)
backend/screenshots/*
!backend/screenshots/.gitkeep
services/reader/screenshots/

# Downloaded model weights
services/*/models/

# The self-hosted Supabase stack, cloned in rather than vendored. It is a large
# independent project with its own release cycle, so committing a snapshot of it would
# mean maintaining a fork nobody asked for. See the README for the two lines that fetch it.
services/supabase/

# Tooling caches
.impeccable/
__pycache__/
*.py[cod]

*.log
.DS_Store
.aider*
