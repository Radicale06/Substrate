# Frontend configuration.
#
# Copy to .env in this folder to configure `docker compose up` run FROM HERE. Running the
# root stack instead reads the repo-root .env, not this one — Compose only picks up the
# .env next to the file it was invoked with.

# Host port the console is published on.
# FRONTEND_PORT=5173

# --- Build-time (Vite) ---
# These are baked into the bundle at build time, not read at runtime.
#
# Where the browser should send API calls. Defaults to /api, which both the Vite dev
# server and the production nginx proxy to the backend — so the browser makes same-origin
# requests and no CORS is involved.
#
# Point this at the backend directly only if you are serving the console from somewhere
# that cannot proxy; the backend then needs CORS_ORIGINS set to this app's origin.
# VITE_API_BASE=http://localhost:3000

# Where `npm run dev` proxies /api to. Only used by the dev server.
# VITE_PROXY_TARGET=http://127.0.0.1:3000
