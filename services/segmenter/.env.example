# Segmenter service configuration.
#
# Copy to .env in this folder to configure `docker compose up` run FROM HERE. Running the
# root stack instead reads the repo-root .env, not this one — Compose only picks up the
# .env next to the file it was invoked with.

# Port the HTTP server listens on.
PORT=3002

# --- Access control ---
# When set, every /segment call must present it as `Authorization: Bearer <key>`.
# The backend must send the same value as SEGMENTER_API_KEY.
# SEGMENTER_API_KEY=

# --- Semantic strategy (optional) ---
# The embedding service, used ONLY by the `semantic` strategy to find topic boundaries.
# Every other strategy needs no model at all — which is why this service starts fine
# without it. Unset, `semantic` degrades to `recursive` and reports `degraded_from`.
# Inside the compose network: http://embeddings:8000
# EMBEDDINGS_URL=http://embeddings:8000
# INFERENCE_API_KEY=
