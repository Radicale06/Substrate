# Reader service configuration.#
# Copy to .env in this folder to configure `docker compose up` run FROM HERE. Running the
# root stack instead reads the repo-root .env, not this one — Compose only picks up the
# .env next to the file it was invoked with. Same variable names either way.

# Port the HTTP server listens on.
PORT=3001

# Directory for saved screenshots. Shared with the backend, which serves them.
STORAGE_DIR=/app/local-storage

# Chrome/Chromium binary puppeteer should drive. Leave unset to use puppeteer's own
# bundled download; the Docker image sets it to the system Chrome.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Skip puppeteer's browser download at install time (the image installs Chrome itself).
PUPPETEER_SKIP_DOWNLOAD=true

# Chrome launch flags. The default suits a small Linux container; --single-process
# crashes Chrome on Windows and macOS, so override this when running outside Docker:
# CHROME_ARGS=--no-sandbox,--disable-dev-shm-usage

# --- Access control ---
# This service will fetch any URL it is handed, so it is meant to stay on an internal
# network. Set a key when it is reachable from anywhere else; the backend must send the
# same value as READER_API_KEY.
# READER_API_KEY=

# --- Downloaded images (X-With-Images-Download) ---
# Base URL this service's stored images should be linked by, e.g. https://reader.example.com.
# Markdown gets pasted elsewhere, so a host-relative /instant-images/... link stops working
# the moment it leaves the response. Unset leaves links relative.
# PUBLIC_BASE_URL=

# Bounds on downloading. Every image on the page is fetched, so an image-heavy site needs
# more headroom than a documentation article; raise these if pages are hitting the cap
# (the per-crawl log line reports how many were skipped as "budget").
# IMAGE_MAX_PER_CRAWL=150
# IMAGE_TOTAL_BYTES_PER_CRAWL=67108864
# IMAGE_DOWNLOAD_BUDGET_MS=45000

# Where downloaded images go.
#   supabase  object storage only; a failed upload leaves the original remote URL
#   local     the shared volume only, ignoring any Supabase credentials
#   auto      Supabase when configured, otherwise local  (default)
# IMAGE_STORAGE=supabase

# --- Supabase Storage (screenshots and images) ---
# These three are a SET. Storage builds public links from SUPABASE_URL, which inside
# compose is an internal address -- so without SUPABASE_PUBLIC_URL every stored image
# link comes back already broken, and the service refuses to enable Storage rather than
# hand out dead URLs.
# Without it, screenshots go to the local volume and the backend serves them.
# SUPABASE_URL=http://kong:8000
# SUPABASE_PUBLIC_URL=http://localhost:8000
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SCREENSHOT_BUCKET=substrate-screenshots
# SUPABASE_IMAGE_BUCKET=substrate-images
