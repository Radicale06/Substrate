# Vector store configuration.
#
# Copy to .env in this folder to configure `docker compose up` run FROM HERE. Running the
# root stack instead reads the repo-root .env, not this one.

# --- Database (required for the service to do anything) ---
# Any Postgres with the pgvector extension available. vecs is Supabase's client but has
# no dependency on the Supabase platform -- plain Postgres works identically.
#
# Prefer a DIRECT, non-pooled URL. The store issues DDL on startup (CREATE SCHEMA,
# CREATE EXTENSION) and when building indexes, and a transaction pooler will refuse it.
# Falls back to DIRECT_URL and then DATABASE_URL when unset.
# VECTORS_DATABASE_URL=postgresql://user:password@host:5432/database

# --- Access control ---
# When set, every /v1/* call must present it as `Authorization: Bearer <key>`.
# The backend must send the same value as VECTORS_API_KEY.
# VECTORS_API_KEY=

# --- Limits ---
# Records accepted in one upsert call.
# VECTORS_MAX_BATCH=500

# Rows returned by one query.
# VECTORS_MAX_LIMIT=100

# pgvector cannot build an index beyond 2000 dimensions, so a wider collection would
# sequentially scan every query. Creation is refused past this rather than letting you
# discover it under load. Raise it only if you accept that.
# VECTORS_MAX_DIMENSION=2000
